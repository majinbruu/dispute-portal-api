# Reverse proxy for docker-compose.prod.yml. It terminates TLS for both public host names and is the
# only container that publishes a port.
#
# Caddy picks the certificate source from the host name. For a public name it gets a certificate from
# a public authority (Let's Encrypt) and renews it. For a *.localhost name it signs one with its own
# local certificate authority, which is what makes this runnable on a developer machine.

(security) {
	header Strict-Transport-Security "max-age=31536000"
}

# The web app. nginx in the web container serves the pages and forwards /api/ to the API.
{$APP_HOSTNAME} {
	import security
	reverse_proxy web:8080
}

# Keycloak. Only what a browser needs to sign in to the acme-bank realm, and what the web app and the
# API call, is public. Everything else Keycloak serves answers 404 here: the account console, client
# registration, token introspection and the other OpenID Connect endpoints, the master realm, the admin
# console, the admin REST API, health and metrics.
{$AUTH_HOSTNAME} {
	import security

	# OpenID Connect: discovery, signing keys, the authorisation endpoint, tokens and sign-out.
	@oidc path_regexp ^/realms/acme-bank/(\.well-known/openid-configuration|protocol/openid-connect/(certs|auth|token|logout|logout/logout-confirm))$

	# What the sign-in pages post to: the sign-in form, a required action such as a new password, and "restart sign-in".
	@forms path_regexp ^/realms/acme-bank/login-actions/(authenticate|required-action|restart)$

	# The style sheets, scripts and images of the sign-in pages. The admin and account consoles' files are left out.
	@assets path_regexp ^/resources/[^/]+/(login|common)/

	handle @oidc {
		reverse_proxy keycloak:8080
	}
	handle @forms {
		reverse_proxy keycloak:8080
	}
	handle @assets {
		reverse_proxy keycloak:8080
	}
	handle {
		respond 404
	}
}
