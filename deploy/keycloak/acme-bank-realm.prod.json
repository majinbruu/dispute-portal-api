{
  "realm": "acme-bank",
  "displayName": "ACME Bank",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "A bank customer who can view and dispute their own debit orders and card transactions."
      },
      {
        "name": "agent",
        "description": "A bank agent who reviews disputes across all customers: approve, reject and comment."
      }
    ]
  },
  "clients": [
    {
      "clientId": "dispute-portal-web",
      "name": "Dispute Portal web app",
      "description": "Single-page app. Public client: Authorization Code flow with PKCE, no client secret.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://${APP_HOSTNAME}/*"
      ],
      "webOrigins": [
        "https://${APP_HOSTNAME}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${APP_HOSTNAME}/*"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "dispute-portal-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "admin-cli",
      "description": "Built into every realm with the password grant switched on. Nothing here uses it, so it is disabled.",
      "enabled": false,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ]
}
