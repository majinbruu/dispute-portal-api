{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Critical",
      "Microsoft.EntityFrameworkCore.Update": "Critical"
    }
  },
  "AllowedHosts": "localhost",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Auth": {
    "Authority": "",
    "MetadataAddress": "",
    "Audience": "dispute-portal-api",
    "RequireHttpsMetadata": true
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Enabled": false
  },
  "Workers": {
    "Enabled": true,
    "PollIntervalSeconds": 2,
    "AutoApproveAfterSeconds": 0,
    "OutcomeDelaySeconds": 20,
    "BatchSize": 20,
    "IdempotencyKeyRetentionHours": 24
  },
  "Simulator": {
    "DeclineSchemeReferences": [ "ACME-TX-RETURN-REJECT-0001", "74027000000000000000017" ]
  },
  "RateLimiting": {
    "RequestsPerMinute": 300,
    "DisputeSubmissionsPerMinute": 5,
    "CommentsPerMinute": 20
  },
  "ApiDocs": {
    "Enabled": false
  }
}
