# Copy to .env.prod and fill in every value. Compose refuses to start while one is missing.
# Never commit .env.prod.
#
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d

# Public host names, without a scheme or port. The proxy serves both on port 443.
# The *.localhost names below work on one machine together with docker-compose.prod.local.yml.
APP_HOSTNAME=portal.localhost
AUTH_HOSTNAME=auth.localhost

# Secrets. Use long random values, different for each one.
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
