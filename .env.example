# Copy to .env to override the defaults in docker-compose.yml. Everything here is for local demo use only.

# Host ports. Change one if it clashes with something already running on your machine.
# The demo Keycloak realm allows the web app at http://localhost:3000 only, so if you change WEB_PORT
# you must also update redirectUris and webOrigins in deploy/keycloak/acme-bank-realm.json.
WEB_PORT=3000
API_PORT=5080
KEYCLOAK_PORT=8080

# Where the web repo is checked out, relative to this file.
WEB_CONTEXT=../dispute-portal-web

# Demo passwords for the local containers. Never reuse these anywhere real.
POSTGRES_PASSWORD=local-dev-only
KEYCLOAK_ADMIN_PASSWORD=local-dev-only
